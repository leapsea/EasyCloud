# Copy to .env next to compose.yml. The app reads it via env_file; compose also
# uses the EASYCLOUD_DB_* values to create the database in the db container.

# --- Database (compose.yml; the host is fixed to the `db` service) ---
EASYCLOUD_DB_NAME=easycloud
EASYCLOUD_DB_USER=easycloud
EASYCLOUD_DB_PASSWORD=change-me-to-a-long-random-string

# --- First start ---
# Password for the initial `admin` account. Unset: a random one is printed in `docker logs EasyCloud`.
# EASYCLOUD_ADMIN_PASSWORD=

# --- Optional ---
# TZ=Asia/Shanghai
# EASYCLOUD_LOG_LEVEL=info
# Database query log: slow (default) | all | off; threshold in ms
# EASYCLOUD_DB_LOG=slow
# EASYCLOUD_DB_SLOW_MS=300
# EASYCLOUD_UPLOAD_CHUNK_SIZE=16777216
# EASYCLOUD_PLUGINS_TRUSTED_KEYS=
